{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "TripSync Warm Civic Mobility",
  "version": "1.0.0",
  "color": {
    "brand": {
      "logoBlue": { "$value": "#1A73E8", "$cssVariable": "--brand-logo-blue" },
      "actionBlue": { "$value": "#175CD3", "$cssVariable": "--ui-primary" },
      "actionBlueHover": { "$value": "#124CAE", "$cssVariable": "--ui-primary-hover" },
      "navy": { "$value": "#0B1F33", "$cssVariable": "--ui-navy" },
      "teal": { "$value": "#087A55", "$cssVariable": "--ui-success" },
      "signalOrange": { "$value": "#F97316", "$cssVariable": "--brand-signal-orange" }
    },
    "light": {
      "canvas": { "$value": "#F6F7F4", "$cssVariable": "--ui-canvas" },
      "surface": { "$value": "#FFFFFF", "$cssVariable": "--ui-surface" },
      "foreground": { "$value": "#132238", "$cssVariable": "--ui-foreground" },
      "muted": { "$value": "#EEF1F4", "$cssVariable": "--ui-muted" },
      "mutedForeground": { "$value": "#5F6B7A", "$cssVariable": "--ui-muted-foreground" },
      "border": { "$value": "#D8DEE8", "$cssVariable": "--ui-border" },
      "warning": { "$value": "#B45309", "$cssVariable": "--ui-warning" },
      "danger": { "$value": "#B42318", "$cssVariable": "--ui-danger" }
    },
    "dark": {
      "canvas": { "$value": "#0B1220", "$cssVariable": "--ui-canvas", "$theme": "dark" },
      "surface": { "$value": "#111B2E", "$cssVariable": "--ui-surface", "$theme": "dark" },
      "foreground": { "$value": "#F6F8FB", "$cssVariable": "--ui-foreground", "$theme": "dark" },
      "muted": { "$value": "#1B2940", "$cssVariable": "--ui-muted", "$theme": "dark" },
      "mutedForeground": { "$value": "#B7C2D0", "$cssVariable": "--ui-muted-foreground", "$theme": "dark" },
      "border": { "$value": "#33425A", "$cssVariable": "--ui-border", "$theme": "dark" },
      "primary": { "$value": "#6EA8FE", "$cssVariable": "--ui-primary", "$theme": "dark" },
      "warning": { "$value": "#F6B84A", "$cssVariable": "--ui-warning", "$theme": "dark" },
      "success": { "$value": "#31B983", "$cssVariable": "--ui-success", "$theme": "dark" },
      "danger": { "$value": "#FF8178", "$cssVariable": "--ui-danger", "$theme": "dark" }
    }
  },
  "typography": {
    "heading": { "$value": "Lexend, Arial, sans-serif" },
    "body": { "$value": "Source Sans 3, Arial, sans-serif" },
    "data": { "$value": "SFMono-Regular, Consolas, Liberation Mono, monospace" }
  },
  "radius": {
    "control": { "$value": "12px", "$cssVariable": "--clay-radius-control" },
    "card": { "$value": "20px", "$cssVariable": "--clay-radius-card" },
    "panel": { "$value": "24px", "$cssVariable": "--clay-radius-panel" }
  },
  "elevation": {
    "light": {
      "low": { "$value": "6px 6px 16px rgba(32, 52, 76, 0.10), -5px -5px 14px rgba(255, 255, 255, 0.92), inset 1px 1px 0 rgba(255, 255, 255, 0.78)", "$cssVariable": "--clay-shadow-low" },
      "raised": { "$value": "12px 12px 30px rgba(32, 52, 76, 0.14), -9px -9px 24px rgba(255, 255, 255, 0.94), inset 1px 1px 0 rgba(255, 255, 255, 0.84)", "$cssVariable": "--clay-shadow-raised" },
      "inset": { "$value": "inset 3px 3px 8px rgba(32, 52, 76, 0.10), inset -3px -3px 8px rgba(255, 255, 255, 0.86)", "$cssVariable": "--clay-shadow-inset" },
      "pressed": { "$value": "inset 4px 4px 10px rgba(20, 43, 72, 0.18), inset -3px -3px 8px rgba(255, 255, 255, 0.74)", "$cssVariable": "--clay-shadow-pressed" }
    },
    "dark": {
      "low": { "$value": "7px 7px 18px rgba(0, 0, 0, 0.34), -4px -4px 12px rgba(82, 110, 151, 0.10), inset 1px 1px 0 rgba(255, 255, 255, 0.05)", "$cssVariable": "--clay-shadow-low", "$theme": "dark" },
      "raised": { "$value": "13px 13px 30px rgba(0, 0, 0, 0.42), -7px -7px 20px rgba(82, 110, 151, 0.11), inset 1px 1px 0 rgba(255, 255, 255, 0.06)", "$cssVariable": "--clay-shadow-raised", "$theme": "dark" },
      "inset": { "$value": "inset 4px 4px 10px rgba(0, 0, 0, 0.34), inset -3px -3px 8px rgba(95, 126, 171, 0.10)", "$cssVariable": "--clay-shadow-inset", "$theme": "dark" },
      "pressed": { "$value": "inset 5px 5px 12px rgba(0, 0, 0, 0.48), inset -3px -3px 8px rgba(95, 126, 171, 0.10)", "$cssVariable": "--clay-shadow-pressed", "$theme": "dark" }
    }
  },
  "motion": {
    "fast": { "$value": "120ms", "$cssVariable": "--motion-fast" },
    "standard": { "$value": "200ms", "$cssVariable": "--motion-standard" },
    "emphasis": { "$value": "300ms", "$cssVariable": "--motion-emphasis" }
  },
  "icon": {
    "small": { "$value": "16px" },
    "medium": { "$value": "20px" },
    "large": { "$value": "24px" }
  }
}
