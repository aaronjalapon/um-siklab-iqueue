# syntax=docker/dockerfile:1.7

# =============================================================================
# IQueue — Frontend Development Image
# Lightweight Node image for hot reload (not the production runner).
# =============================================================================

FROM node:24-bookworm-slim
WORKDIR /app

EXPOSE 3000

# Bind-mount source and host node_modules at runtime for fast local dev.
CMD ["npm", "run", "dev:docker"]
